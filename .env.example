# Copy to .env before running anything:  copy .env.example .env
# The defaults below run the whole application offline: no API key, no network access.

APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000

# ----------------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------------
# Relative SQLite paths resolve under DATA_DIR, so the API, the worker and pytest all
# open the same files regardless of which directory they were started from.
DATA_DIR=var
DATABASE_URL=sqlite+aiosqlite:///meridian.db
COMPANY_DATABASE_URL=sqlite+aiosqlite:///company.db
CHECKPOINT_DATABASE_URL=sqlite:///checkpoints.db
DATABASE_ECHO=false

# Leave REDIS_URL empty to use the in-process queue and in-memory cache. Docker Compose
# sets it to redis://redis:6379/0.
REDIS_URL=

# ----------------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------------
# Generate a real one for anything but local use:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TOKEN_TTL_MINUTES=720

# ----------------------------------------------------------------------------------
# Language model
# ----------------------------------------------------------------------------------
# scripted = deterministic built-in fake model. It covers the three demo questions and the
#            whole test suite, and needs no key. Any other question is refused with an
#            explanation of how to configure a real model.
# openai   = any OpenAI-compatible endpoint (OpenAI, Groq, Ollama).
LLM_PROVIDER=scripted

# Groq, free tier:   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#                    OPENAI_MODEL=llama-3.3-70b-versatile
# Ollama, local:     OPENAI_BASE_URL=http://localhost:11434/v1
#                    OPENAI_MODEL=llama3.1   (no key needed)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# ----------------------------------------------------------------------------------
# Embeddings
# ----------------------------------------------------------------------------------
# hash  = offline feature hashing. No download, deterministic, lower recall.
# local = ChromaDB ONNX MiniLM. Downloads the model on first use; falls back to hash with a
#         single warning if the download is blocked.
# openai = OpenAI-compatible embedding API, needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=text-embedding-3-small
HASH_EMBEDDING_DIMENSIONS=512

# ----------------------------------------------------------------------------------
# Tools
# ----------------------------------------------------------------------------------
# fixtures = recorded responses from tests/fixtures. No outbound network calls.
# live     = real HTTP calls (Frankfurter, Wikipedia, DuckDuckGo, and Tavily if keyed).
TOOLS_MODE=fixtures
TAVILY_API_KEY=
TOOL_TIMEOUT_SECONDS=20
SQL_ROW_LIMIT=500
TOOL_CACHE_TTL_SECONDS=900

# ----------------------------------------------------------------------------------
# Default budgets. A run may request less than these, never more.
# ----------------------------------------------------------------------------------
MAX_STEPS=12
MAX_TOKENS=120000
MAX_COST_USD=0.50
MAX_WALL_SECONDS=300

# ----------------------------------------------------------------------------------
# Worker
# ----------------------------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_SECONDS=5

# ----------------------------------------------------------------------------------
# API and observability
# ----------------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
